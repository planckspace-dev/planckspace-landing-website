# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents what to set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code / agent skills tooling (not part of the app)
.agents/
.claude/
skills-lock.json

# Raw dashboard captures — kept locally to re-run scripts/crop-product-shots.mjs.
# Several contain teammate email addresses and this repo is public, so the raw
# sources are NOT committed. Only the clean hero shot and the PII-free derived
# crops (both actually imported by the build) are tracked.
/assets/product-shots/*.png
!/assets/product-shots/02-overview-panel.png
