# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit a real key.

# Required. Create at https://resend.com/api-keys ("Sending access" is enough).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact + demo submissions are delivered. Overrides CONTACT_EMAIL in
# src/lib/plans.ts, so whatever is set here is what production actually uses.
# The mailbox must exist (planckspace.dev receives via Hostinger) or sends bounce.
CONTACT_TO_EMAIL=we@planckspace.dev

# Timezone for the "received at" line in the notification email.
# Any IANA name. Defaults to UTC when unset or invalid.
# CONTACT_TIMEZONE=Asia/Kolkata

# Sender. Must be on a domain verified at https://resend.com/domains.
# Until planckspace.dev is verified, leave this unset: the code falls back to
# onboarding@resend.dev, which can ONLY deliver to the Resend account owner.
# CONTACT_FROM_EMAIL=PlanckSpace <hello@planckspace.dev>
